# --- Required, both free-tier ---
GROQ_API_KEY=          # free at console.groq.com
TAVILY_API_KEY=        # free tier (1,000 searches/month) at tavily.com

# --- Optional: only needed if you switch providers in config.yaml ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Vector store (local Qdrant via Docker - no key needed by default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLMOps tracking - leave blank to use local ./mlruns (see config.yaml)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Deployment - only needed once you actually deploy to AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ECR_LOGIN_URI=
ECR_REPOSITORY_NAME=partex-agentic-ai
